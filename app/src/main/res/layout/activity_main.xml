<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 32dp Guidelines -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideNorth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="32dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideSouth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="32dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideWest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="32dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="32dp" />

    <!-- Display -->
    <TextView
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="44sp"
        android:gravity="end"
        android:padding="8dp"
        android:maxLines="1"
        android:ellipsize="start"
        app:layout_constraintTop_toTopOf="@id/guideNorth"
        app:layout_constraintStart_toStartOf="@id/guideWest"
        app:layout_constraintEnd_toEndOf="@id/guideEast" />

    <!-- Keypad container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/display"
        app:layout_constraintBottom_toBottomOf="@id/guideSouth"
        app:layout_constraintStart_toStartOf="@id/guideWest"
        app:layout_constraintEnd_toEndOf="@id/guideEast">

        <!-- Column guidelines (5 columns) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.2" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.4" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.8" />

        <!-- Row guidelines (4 rows) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.50" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/row3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.75" />

        <!-- Row 1: 7 8 9 √ C -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="7"
            android:tag="7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/row1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/col1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="8"
            android:tag="8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/row1"
            app:layout_constraintStart_toStartOf="@id/col1"
            app:layout_constraintEnd_toStartOf="@id/col2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="9"
            android:tag="9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/row1"
            app:layout_constraintStart_toStartOf="@id/col2"
            app:layout_constraintEnd_toStartOf="@id/col3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSqrt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="√"
            android:tag="√"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/row1"
            app:layout_constraintStart_toStartOf="@id/col3"
            app:layout_constraintEnd_toStartOf="@id/col4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="C"
            android:tag="C"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/row1"
            app:layout_constraintStart_toStartOf="@id/col4"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Row 2: 4 5 6 ÷ % -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="4"
            android:tag="4"
            app:layout_constraintTop_toTopOf="@id/row1"
            app:layout_constraintBottom_toTopOf="@id/row2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/col1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="5"
            android:tag="5"
            app:layout_constraintTop_toTopOf="@id/row1"
            app:layout_constraintBottom_toTopOf="@id/row2"
            app:layout_constraintStart_toStartOf="@id/col1"
            app:layout_constraintEnd_toStartOf="@id/col2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="6"
            android:tag="6"
            app:layout_constraintTop_toTopOf="@id/row1"
            app:layout_constraintBottom_toTopOf="@id/row2"
            app:layout_constraintStart_toStartOf="@id/col2"
            app:layout_constraintEnd_toStartOf="@id/col3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="÷"
            android:tag="÷"
            app:layout_constraintTop_toTopOf="@id/row1"
            app:layout_constraintBottom_toTopOf="@id/row2"
            app:layout_constraintStart_toStartOf="@id/col3"
            app:layout_constraintEnd_toStartOf="@id/col4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPct"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="%"
            android:tag="%"
            app:layout_constraintTop_toTopOf="@id/row1"
            app:layout_constraintBottom_toTopOf="@id/row2"
            app:layout_constraintStart_toStartOf="@id/col4"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Row 3: 1 2 3 × − -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="1"
            android:tag="1"
            app:layout_constraintTop_toTopOf="@id/row2"
            app:layout_constraintBottom_toTopOf="@id/row3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/col1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="2"
            android:tag="2"
            app:layout_constraintTop_toTopOf="@id/row2"
            app:layout_constraintBottom_toTopOf="@id/row3"
            app:layout_constraintStart_toStartOf="@id/col1"
            app:layout_constraintEnd_toStartOf="@id/col2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="3"
            android:tag="3"
            app:layout_constraintTop_toTopOf="@id/row2"
            app:layout_constraintBottom_toTopOf="@id/row3"
            app:layout_constraintStart_toStartOf="@id/col2"
            app:layout_constraintEnd_toStartOf="@id/col3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="×"
            android:tag="×"
            app:layout_constraintTop_toTopOf="@id/row2"
            app:layout_constraintBottom_toTopOf="@id/row3"
            app:layout_constraintStart_toStartOf="@id/col3"
            app:layout_constraintEnd_toStartOf="@id/col4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="-"
            android:tag="-"
            app:layout_constraintTop_toTopOf="@id/row2"
            app:layout_constraintBottom_toTopOf="@id/row3"
            app:layout_constraintStart_toStartOf="@id/col4"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Row 4: ± 0 . + = -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="±"
            android:tag="±"
            app:layout_constraintTop_toTopOf="@id/row3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/col1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="0"
            android:tag="0"
            app:layout_constraintTop_toTopOf="@id/row3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/col1"
            app:layout_constraintEnd_toStartOf="@id/col2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="."
            android:tag="."
            app:layout_constraintTop_toTopOf="@id/row3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/col2"
            app:layout_constraintEnd_toStartOf="@id/col3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="+"
            android:tag="+"
            app:layout_constraintTop_toTopOf="@id/row3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/col3"
            app:layout_constraintEnd_toStartOf="@id/col4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEq"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:text="="
            android:tag="="
            app:layout_constraintTop_toTopOf="@id/row3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/col4"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
